# ChessPoint Publisher — переменные окружения. Скопируй в .env.local и заполни.
# .env.local в git не коммитить.

# Supabase: адрес и публичный anon-ключ (уходит в браузер, только для загрузки файлов)
NEXT_PUBLIC_SUPABASE_URL=https://<host>
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Серверный ключ. Полный service_role ИЛИ ограниченный JWT роли cp_publisher
# (только таблица posts + bucket post-images) — lib/supabase/server.ts понимает оба.
SUPABASE_SERVICE_ROLE_KEY=<service-or-scoped-key>

# Токен для POST /api/import (любая длинная случайная строка)
IMPORT_TOKEN=<random-token>
